generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model Category {
  id        Int       @id @default(autoincrement())
  name      String    @db.VarChar(100)
  slug      String    @unique @db.VarChar(100)
  icon      String?   @db.VarChar(50)
  parentId  Int?
  parent    Category? @relation("CategoryTree", fields: [parentId], references: [id])
  children  Category[] @relation("CategoryTree")
  products  Product[]
  sortOrder Int       @default(0)
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  @@index([parentId])
  @@index([slug])
}

model Product {
  id          Int       @id @default(autoincrement())
  name        String    @db.VarChar(255)
  slug        String    @unique @db.VarChar(255)
  description String?   @db.Text
  imageUrl    String?   @db.VarChar(500)
  categoryId  Int
  category    Category  @relation(fields: [categoryId], references: [id])
  prices      Price[]
  isActive    Boolean   @default(true)
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt
  @@index([categoryId])
  @@index([slug])
}

model Merchant {
  id              Int       @id @default(autoincrement())
  name            String    @db.VarChar(255)
  slug            String    @unique @db.VarChar(255)
  logoUrl         String?   @db.VarChar(500)
  websiteUrl      String?   @db.VarChar(500)
  reputationScore Decimal?  @db.Decimal(3, 2)
  description     String?   @db.Text
  prices          Price[]
  isActive        Boolean   @default(true)
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt
  @@index([slug])
}

model Price {
  id            Int       @id @default(autoincrement())
  productId     Int
  product       Product   @relation(fields: [productId], references: [id])
  merchantId    Int
  merchant      Merchant  @relation(fields: [merchantId], references: [id])
  price         Decimal   @db.Decimal(10, 2)
  currency      String    @default("CNY") @db.VarChar(10)
  stockStatus   String    @default("in_stock") @db.VarChar(50)
  warrantyInfo  String?   @db.VarChar(255)
  productUrl    String?   @db.VarChar(500)
  lastUpdated   DateTime  @default(now())
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt
  @@unique([productId, merchantId])
  @@index([productId])
  @@index([merchantId])
  @@index([price])
}

model Tag {
  id        Int       @id @default(autoincrement())
  name      String    @unique @db.VarChar(50)
  products  Product[]
  @@index([name])
}